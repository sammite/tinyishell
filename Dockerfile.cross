# Dockerfile.cross
# Hermetic multi-architecture build & test environment for tinyishell
FROM alpine:latest

RUN apk update && apk add --no-cache \
    bash \
    curl \
    tar \
    make \
    gcc \
    musl-dev \
    qemu-arm \
    qemu-aarch64 \
    qemu-mips \
    qemu-mipsel \
    qemu-riscv64 \
    qemu-riscv32 \
    qemu-ppc \
    qemu-mips64 \
    qemu-mips64el

WORKDIR /work

CMD ["make", "cross_all"]
